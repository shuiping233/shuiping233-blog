{
  "dependencies": {
    "github-markdown-css": "^5.8.1",
    "markdown-it-emoji": "^3.1.0",
    "markstream-vue": "^1.0.8",
    "viewerjs": "^1.11.7",
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "cross-env": "^10.1.0",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.8",
    "vite-plugin-compression": "^0.5.1",
    "vue-tsc": "^3.2.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "img:conv": "tsx scripts/convert-webp.ts",
    "md:metadata": "tsx scripts/add-md-metadata.ts",
    "gen:posts-json": "tsx scripts/gen-posts-json.ts"
  },
  "lint-staged": {
    "docs/**/*.md": [
      "cross-env GIT_HOOKS_HUSKY=true tsx scripts/add-md-metadata.ts"
    ],
    "docs/public/images/**/*.{png,jpg,jpeg,gif}": [
      "node scripts/convert-webp.ts",
      "git add ."
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  }
}
